# copy to .env and fill in
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5.5             # any model with structured outputs; gpt-4o-2024-08-06 = faster, cheaper, simpler plans
# LLM_TWO_PASS=1        # editorial brief first, then the plan (better edits, ~2x LLM tokens)
# LLM_REASONING=medium  # gpt-5 / o-series only: minimal | low | medium | high

# b-roll: stock search needs ONE free key (pexels.com/api or pixabay.com/api/docs). Without a key the AI
# generates images with your OpenAI key (~$0.006 each) and uses them with motion in place of video.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# BROLL_IMAGE_SOURCE=auto   # auto | search | generate
# BROLL_VIDEO_SOURCE=auto   # auto | search | generate (Sora 2, ~$0.40 per 4s clip, slow) | off
# IMAGE_MODEL=gpt-image-1-mini
# IMAGE_QUALITY=low         # low | medium | high
# VIDEO_MODEL=sora-2
# VIDEO_SECONDS=4

# faster-whisper: tiny | base | small | medium | large-v3-turbo | large-v3
# large-v3-turbo = large-v3 quality, ~5x faster, 1.6 GB - the best pick on a CPU. large-v3 = 3 GB and slow.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# WHISPER_THREADS=4    # cpu threads: 4 (6 on 12+ core CPUs) by default - MORE is usually slower, don't set 16+
# WHISPER_BEAM=5       # 1 = greedy, a bit faster, slightly less accurate
# NVIDIA GPU: WHISPER_DEVICE=cuda + WHISPER_COMPUTE=float16 (pip install nvidia-cublas-cu12 nvidia-cudnn-cu12)

# optional
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# X264_PRESET=medium
# X264_CRF=18
# MAX_UPLOAD_MB=200
# MAX_CONCURRENT_JOBS=1
# LLM_PRICE_IN=2.50     # usd per 1M prompt tokens (cost estimate only)
# LLM_PRICE_OUT=10.00   # usd per 1M completion tokens
